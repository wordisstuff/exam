# Phase 1 commercial platform environment
# Keep real secrets in local/hosting environment configuration only.

# Leave as local until the Supabase-backed routes are wired and validated.
NEXT_PUBLIC_PLATFORM_DATA_MODE=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paid access is scaffolded but intentionally off until Stripe + Supabase are configured.
PLATFORM_ENTITLEMENT_ENFORCEMENT=off
PLATFORM_BASE_URL=http://localhost:3000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_QB_180_DAY=
